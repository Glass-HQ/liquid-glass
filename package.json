{
  "name": "liquid-glass-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@lisse/core": "^0.7.3",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "typescript": "^7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "vite-plus": "1.6.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "node scripts/dev.mjs",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "release": "node scripts/release.ts",
    "bench": "node apps/bench/runner/run.mjs",
    "native": "vp run native:build && open \"apps/native-reference/build/Liquid Glass Reference.app\"",
    "native:build": "node scripts/build-native.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "publint": "^0.3.25",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.4",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^26.13.1"
  }
}
