{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx --yes bun@1.4.3-canary.20261021.1 run build",
  "installCommand": "npx --yes bun@1.4.3-canary.20261021.1 install --frozen-lockfile",
  "outputDirectory": "apps/site/dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
