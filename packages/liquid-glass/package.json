{
  "name": "@glass-sdk/liquid-glass",
  "version": "0.0.2",
  "description": "Liquid Glass materials and accessible React components for the web and Electron, built with vgpu and WGSL.",
  "keywords": [
    "electron",
    "liquid-glass",
    "react",
    "refraction",
    "vgpu",
    "webgpu"
  ],
  "homepage": "https://liquid-glass.glassapp.dev",
  "bugs": {
    "url": "https://github.com/Glass-HQ/liquid-glass/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glass-HQ/liquid-glass.git",
    "directory": "packages/liquid-glass"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./gpu": {
      "types": "./dist/types/gpu/index.d.ts",
      "import": "./dist/gpu.js"
    },
    "./dom": {
      "types": "./dist/types/dom/index.d.ts",
      "import": "./dist/dom.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.css.ts",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css && cp src/styles.d.css.ts dist/styles.d.css.ts",
    "dev": "vp build --watch --emptyOutDir false",
    "test": "bun test",
    "check:size": "node scripts/check-size.mjs",
    "check:gpu": "vgpu doctor && node scripts/check-shader.mjs && node scripts/gpu-smoke.mjs",
    "prepublishOnly": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "@lisse/core": "catalog:",
    "vgpu": "^0.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@types/bun": "^1.4.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vgpu/wgsl": "^0.6.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
